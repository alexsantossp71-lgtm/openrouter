# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# Chave da API Replicate – gere em https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: origins permitidas pelo CORS (separadas por vírgula)
# ALLOWED_ORIGINS=https://seudominio.com,https://outro.dominio.com

# Opcional: modelo alternativo do Replicate
# REPLICATE_MODEL=playgroundai/playground-v2.5-1024px-aesthetic:61260cd6b4747eb3b8178875501d51a66275811c75949d21df263300072b7a95

# Opcional: limite de rate limiting (requisições por janela)
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=60

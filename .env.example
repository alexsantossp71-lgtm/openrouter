# Copie este arquivo para .env e preencha com seus valores.
# Siga o formato: CHAVE=valor

# Obrigatória — sua chave da API Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional — modelo a ser usado (padrão: Playground v2.5 1024px)
# REPLICATE_MODEL=playgroundai/playground-v2.5-1024px-aesthetic:61260cd6b4747eb3b8178875501d51a66275811c75949d21df263300072b7a95

# Opcional — limite de requisições por janela de tempo (rate limiting)
# RATE_LIMIT=5
# RATE_LIMIT_WINDOW=60

# Opcional — porta do servidor
# PORT=5000